      "version": 1,
      "versionNonce": 1489565584,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Existe um GND ao lado do D13 — é o caminho mais curto, use esse.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Existe um GND ao lado do D13 — é o caminho mais curto, use esse.",
