      "link": null,
      "locked": false,
      "text": "VCC NUNCA no 5V. Só as ENTRADAS do nRF24 toleram 5 V — o VCC não.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "VCC NUNCA no 5V. Só as ENTRADAS do nRF24 toleram 5 V — o VCC não.",
