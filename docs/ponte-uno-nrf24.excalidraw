      "versionNonce": 889090371,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "No Uno, 3V3 e GND ficam no header POWER; D6 e D10–D13 no DIGITAL, do outro lado da placa.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No Uno, 3V3 e GND ficam no header POWER; D6 e D10–D13 no DIGITAL, do outro lado da placa.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "e100",
      "type": "text",
      "x": 352,
