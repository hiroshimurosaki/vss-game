<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>controller_interpreter</name>
  <version>0.0.0</version>
  <description>Leitura de joystick e teclado, agregada em direção e ações por robô</description>
  <maintainer email="fernando.murusaki@unesp.br">Carrossel Caipira</maintainer>
  <license>MIT</license>
  <author>Arthur</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <depend>joy</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>shared_interfaces</depend>
  <depend>libsdl2-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
